* text=auto
*.md text eol=lf
*.txt text eol=lf
*.json text eol=lf
*.py text eol=lf
*.pdf binary
*.xlsx binary
*.pptx binary
*.zip binary
*.png binary
*.jpg binary

# Preserve third-party reference bytes and recorded source checksums.
/01_Resources/** -text

# iCalendar requires CRLF; folded content can end with significant spaces.
*.ics -text whitespace=-blank-at-eol,cr-at-eol

# Preserve the published digital-usage release checksum.
/03_Data_and_Code/Digital_Usage/data/published_indices.csv -text

# Preserve CSV-writer output bytes and recorded result checksums.
/03_Data_and_Code/Statistical_Inference/results/logic_cost_ratios.csv -text whitespace=cr-at-eol
/03_Data_and_Code/Statistical_Inference/results/logic_extrapolation.csv -text whitespace=cr-at-eol
