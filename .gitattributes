* text=auto
*.md text eol=lf
*.txt text eol=lf
*.json text eol=lf
*.py text eol=lf
*.pdf binary
*.xlsx binary
*.pptx binary
*.zip binary
*.png binary
*.jpg binary

# Preserve third-party reference bytes and recorded source checksums.
/01_Resources/** -text

# iCalendar requires CRLF; folded content can end with significant spaces.
*.ics -text whitespace=-blank-at-eol,cr-at-eol
